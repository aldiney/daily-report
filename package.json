    "src/",
    "wazap-host/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/",
    "start": "node bin/daily-report.mjs"
  },
  "keywords": [
    "daily",
    "report",
    "standup",
    "whatsapp",
    "evolution-api",
    "wazap",
    "git-log",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldiney/daily-report.git"
  },
